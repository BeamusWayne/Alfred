{
  "name": "alfred-agent",
  "version": "0.5.0",
  "description": "Alfred — a verifiable autonomous coding agent (CLI). Machine-enforced done-gates, agent-curated inspectable memory, signed replayable run ledgers. TypeScript on Bun.",
  "type": "module",
  "bin": {
    "alfred": "src/index.ts"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "feature_list.example.json"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "alfred": "bun run src/index.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests",
    "format": "biome format --write src tests",
    "check": "biome check src tests",
    "demo": "cd examples/demo && ./reset.sh >/dev/null && ALFRED_MOCK_SCRIPTS=./scripts.ts bun ../../src/index.ts run --verify 'bun test add.test.ts' --max-features 1",
    "demo:verify": "cd examples/demo && bun ../../src/index.ts ledger verify",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "bun run typecheck && bun test tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "commander": "^14.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.2.14",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeamusWayne/Alfred.git"
  },
  "homepage": "https://beamuswayne.github.io/Alfred/",
  "bugs": {
    "url": "https://github.com/BeamusWayne/Alfred/issues"
  },
  "author": "Beamus Wayne (https://beamuswayne.github.io)",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "autonomous-agent",
    "claude",
    "anthropic",
    "bun",
    "verifiable",
    "ledger"
  ],
  "license": "MIT"
}
